# Maintainer: Rishi-Bhati <bhatirishi5@gmail.com>
# The source is the GitHub tag tarball for $_tag.
pkgname=intermux
pkgver=3.0.0beta1
# pacman versions cannot contain "-", so pkgver is 3.0.0beta1 and the tag is set here
# explicitly. The 3.0.0-beta.1 pre-release is tagged linux-v3.0.0-beta.1.
_tag="linux-v3.0.0-beta.1"
pkgrel=1
pkgdesc="Bind individual applications to specific network interfaces"
arch=('x86_64' 'aarch64')
url="https://github.com/Rishi-Bhati/intermux"
license=('MIT')
# tk (with the X11 libraries it pulls in) and mpdecimal: the PyInstaller bundle carries Python and
# Tcl/Tk but links them against these system libraries. hicolor-icon-theme owns the icon directories.
depends=('iproute2' 'iptables' 'polkit' 'util-linux' 'procps-ng' 'xdg-utils' 'glibc' 'tk' 'mpdecimal'
         'hicolor-icon-theme')
# pyinstaller is in the AUR, not the official repositories
makedepends=('pyinstaller' 'cargo')
optdepends=('nftables: route already-running apps'
            'curl: public IP check')
install=intermux.install
# !strip: stripping breaks the PyInstaller bundle
options=('!strip' '!debug')
source=("$pkgname-$_tag.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
# Update this pkgsum on every release, otherwise validation fails
sha256sums=('59f3049fe9833b531140b94c87233dc52356d2161d19f4ece5f01b3d8548fd19')

build() {
    cd "$srcdir/$pkgname-$_tag"
    # Keep PyInstaller's cache in the build tree (no $HOME in clean chroots)
    export PYINSTALLER_CONFIG_DIR="$srcdir/pyi-config"
    pyinstaller intermux_linux.spec --noconfirm \
        --distpath "$srcdir/dist" --workpath "$srcdir/build"

    export CARGO_TARGET_DIR="$srcdir/cargo-target"
    cargo build --release --locked --manifest-path rust/Cargo.toml
    for bin in intermuxd intermux-tray; do
        if [ -f "$CARGO_TARGET_DIR/release/$bin" ]; then
            install -m 0755 "$CARGO_TARGET_DIR/release/$bin" "$srcdir/dist/intermux/$bin"
        fi
    done
}

package() {
    local src="$srcdir/$pkgname-$_tag"

    # Onedir bundle; the polkit policy annotates /usr/lib/intermux/intermux
    install -dm755 "$pkgdir/usr/lib/intermux"
    cp -a "$srcdir/dist/intermux/." "$pkgdir/usr/lib/intermux/"
    chmod -R a+rX "$pkgdir/usr/lib/intermux"
    chmod 755 "$pkgdir/usr/lib/intermux/intermux"

    install -dm755 "$pkgdir/usr/bin"
    ln -s /usr/lib/intermux/intermux "$pkgdir/usr/bin/intermux"

    install -Dm644 "$src/packaging/linux/org.intermux.policy" \
        "$pkgdir/usr/share/polkit-1/actions/org.intermux.policy"
    install -Dm644 "$src/packaging/linux/intermux.desktop" \
        "$pkgdir/usr/share/applications/intermux.desktop"
    install -Dm644 "$src/packaging/linux/intermux-tray.desktop" \
        "$pkgdir/usr/share/applications/intermux-tray.desktop"
    install -Dm644 "$src/packaging/linux/intermux.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/intermux.svg"
    install -Dm644 "$src/packaging/linux/intermux.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/org.intermux.InterMux.metainfo.xml"
    # Watcher that resets routing when routed apps exit (enable: systemctl enable --now intermux-watch)
    install -Dm644 "$src/packaging/linux/intermux-watch.service" \
        "$pkgdir/usr/lib/systemd/system/intermux-watch.service"
    install -Dm644 "$src/packaging/linux/intermux-watch.preset" \
        "$pkgdir/usr/lib/systemd/system-preset/90-intermux.preset"
    # User units for daemon socket activation
    install -Dm644 "$src/packaging/linux/intermuxd.socket" \
        "$pkgdir/usr/lib/systemd/user/intermuxd.socket"
    install -Dm644 "$src/packaging/linux/intermuxd.service" \
        "$pkgdir/usr/lib/systemd/user/intermuxd.service"
    install -Dm644 "$src/license" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
