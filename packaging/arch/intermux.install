post_install() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    echo ">>> Enable the routing watcher so routing resets when a routed app exits:"
    echo ">>>   sudo systemctl enable --now intermux-watch.service"
}

post_upgrade() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl try-restart intermux-watch.service >/dev/null 2>&1 || true
}

pre_remove() {
    systemctl disable --now intermux-watch.service >/dev/null 2>&1 || true
}

post_remove() {
    systemctl daemon-reload >/dev/null 2>&1 || true
}
