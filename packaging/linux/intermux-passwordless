#!/bin/sh
# Turns InterMux password prompts on or off for the user who runs it, from the window's switch:
#   pkexec /usr/lib/intermux/intermux-passwordless on|off
# pkexec maps this path to the polkit action org.intermux.passwordless, which always asks for an
# administrator password. The marker below tells InterMux it came through that action; pkexec clears
# the environment, so a caller cannot set it on the helper's own (possibly passwordless) action.
set -eu
case "${1:-}" in
    on|off) ;;
    *) echo "[X] usage: pkexec $0 on|off" >&2; exit 2 ;;
esac
INTERMUX_PASSWORDLESS_ACTION=1
export INTERMUX_PASSWORDLESS_ACTION
exec /usr/lib/intermux/intermux passwordless "$1"
